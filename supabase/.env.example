# MemoryMesh — Edge Function secrets
# Set with:  supabase secrets set --env-file supabase/.env
# Never commit supabase/.env.

# AI providers (any subset; the router skips providers without a key)
ANTHROPIC_API_KEY=
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
OPENAI_API_KEY=

# Optional model overrides
CLAUDE_MODEL=claude-opus-5-5
KIMI_MODEL=kimi-k2-turbo-preview
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_TRANSCRIBE_MODEL=whisper-1

# Pinecone serverless index (dimension 1536, metric cosine)
PINECONE_API_KEY=
PINECONE_INDEX_HOST=https://your-index-xxxx.svc.your-region.pinecone.io

# RevenueCat webhook shared secret (Authorization header value configured in RevenueCat)
REVENUECAT_WEBHOOK_SECRET=

# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# automatically into deployed Edge Functions.
