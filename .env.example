# MemoryMesh — client environment (copy to .env, never commit .env)
#
# Only values that are SAFE TO SHIP inside the app binary belong here.
# Every EXPO_PUBLIC_ variable is embedded in the JS bundle and readable by anyone.
# AI provider keys and the Pinecone key are NOT client variables: they live in
# Supabase Edge Function secrets (see supabase/.env.example and DEPLOYMENT.md).

# Supabase project (the anon key is public by design; RLS protects the data)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat public SDK keys (public by design)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxxxxxxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxxxxxxx

# AdMob banner unit IDs (leave empty to use Google's test units in development)
EXPO_PUBLIC_ADMOB_BANNER_IOS=
EXPO_PUBLIC_ADMOB_BANNER_ANDROID=
